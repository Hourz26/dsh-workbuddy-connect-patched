+function clampWorkbuddyMaxTokens(body) {
+	if (!isObject(body)) return;
+	const modelId = typeof body["model"] === "string" ? body["model"] : "";
+	const table = typeof FALLBACK_WORKBUDDY_MODELS !== "undefined" && Array.isArray(FALLBACK_WORKBUDDY_MODELS) ? FALLBACK_WORKBUDDY_MODELS : [];
